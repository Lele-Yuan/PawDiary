/* ===== 全局变量（紫色品牌） ===== */
page {
  /* 主色：紫色品牌 */
  --primary-color: #7B5CF5;
  --primary-dark: #5A3FE0;
  --primary-light: #A48BFA;
  --primary-bg: #EFEAFE;
  --primary-gradient-start: #ace9f3;
  --primary-gradient-end: #fcd9b8;

  /* 兼容旧变量 */
  --secondary-color: #EFEAFE;
  --teal-color: #4FB1F0;
  --teal-light: #E3F0FE;
  --beige-color: #F8F5FF;
  --progress-color: #7B5CF5;

  /* 中性 */
  --bg-color: #F6F3FF;
  --card-bg: #FFFFFF80;
  --card-soft-bg: #F8F5FF;

  /* 文字 */
  --text-color: #1F1A3D;
  --text-gray: #a3a3a3;
  --text-secondary: #6B6585;
  --text-light: #B5B0C8;

  /* 边框/分割 */
  --border-color: #ECE7F7;
  --divider-color: #F0EBFC;

  /* 状态 */
  --success-color: #94c0e9;
  --warning-color: #fece71;
  --danger-color: #f97e54;
  --info-color: #c3e2ff;

  /* 软色卡片背景 */
  --soft-purple: #EFEAFE;
  --soft-blue: #E3F0FE;
  --soft-pink: #FCE6EE;
  --soft-orange: #fff5ec;
  --soft-green: #E5F6EC;
  --soft-yellow: #FFF6D9;

  /* 阴影 */
  --shadow-card: 0 8rpx 24rpx rgba(123, 92, 245, 0.08);
  --shadow-button: 0 8rpx 20rpx rgba(123, 92, 245, 0.32);
  --shadow-floating: 0 16rpx 40rpx rgba(60, 40, 130, 0.16);

  /* 圆角 */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-pill: 999rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: transparent;
  box-sizing: border-box;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 通用布局 ===== */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* ===== 通用卡片 ===== */
.card,
.card-base {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin: 20rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.card-sm {
  background-color: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin: 16rpx 28rpx;
  box-shadow: var(--shadow-card);
}

/* ===== 通用按钮 ===== */
.btn-primary {
  background: var(--primary-color);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-pill);
  padding: 24rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.5;
  letter-spacing: 1rpx;
  box-shadow: var(--shadow-button);
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-primary::after { border: none; }

.btn-primary-hover {
  background: var(--primary-dark);
  opacity: 0.95;
  transform: translateY(1rpx);
}

.btn-secondary {
  background-color: var(--primary-bg);
  color: var(--primary-color);
  border: none;
  border-radius: var(--radius-pill);
  padding: 24rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.5;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-secondary::after { border: none; }

.btn-outline {
  background-color: transparent;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: var(--radius-pill);
  padding: 18rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-outline::after { border: none; }

.btn-outline-hover {
  background-color: var(--primary-bg);
}

.btn-small {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  border-radius: var(--radius-pill);
}

/* ===== 悬浮添加按钮 ===== */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 220rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color), var(--danger-color));
  box-shadow: 0 8rpx 24rpx rgba(232, 135, 90, 0.4);
  color: #FFFFFF;
  font-size: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: var(--shadow-button);
  z-index: 100;
}

.fab-btn-hover {
  transform: scale(0.92);
  opacity: 0.9;
}

/* ===== 软色标签 ===== */
.tag,
.soft-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-primary, .soft-tag-purple {
  background-color: var(--soft-purple);
  color: var(--primary-color);
}

.tag-success, .soft-tag-green {
  background-color: var(--soft-green);
  color: var(--success-color);
}

.tag-warning, .soft-tag-orange {
  background-color: var(--soft-orange);
  color: var(--warning-color);
}

.tag-info, .soft-tag-blue {
  background-color: var(--soft-blue);
  color: var(--info-color);
}

.tag-purple, .soft-tag-pink {
  background-color: var(--soft-pink);
  color: var(--danger-color);
}

.soft-tag-yellow {
  background-color: var(--soft-yellow);
  color: #C99500;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 12rpx;
  background-color: var(--primary-bg);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary-color);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ===== 空状态 ===== */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-light);
  text-align: center;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background-color: var(--divider-color);
  margin: 20rpx 0;
}

/* ===== 文字工具类 ===== */
.text-primary { color: var(--primary-color); }
.text-secondary { color: var(--text-secondary); }
.text-light { color: var(--text-light); }
.text-success { color: var(--success-color); }
.text-warning { color: var(--warning-color); }
.text-danger { color: var(--danger-color); }
.text-bold { font-weight: 600; }
.text-center { text-align: center; }
.text-large { font-size: 36rpx; }
.text-small { font-size: 24rpx; }
.text-xl { font-size: 48rpx; }

/* ===== 间距 ===== */
.mt-sm { margin-top: 12rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 40rpx; }
.mb-sm { margin-bottom: 12rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 40rpx; }
.ml-sm { margin-left: 12rpx; }
.ml-md { margin-left: 24rpx; }
.mr-sm { margin-right: 12rpx; }
.mr-md { margin-right: 24rpx; }
.p-sm { padding: 12rpx; }
.p-md { padding: 24rpx; }
.p-lg { padding: 40rpx; }

/* ===== 表单 ===== */
.form-group { margin-bottom: 32rpx; }

.form-label {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 28rpx;
  background-color: var(--card-soft-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
  transition: border-color 0.3s ease;
}

.form-textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 22rpx 28rpx;
  background-color: var(--card-soft-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
  transition: border-color 0.3s ease;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 84rpx;
  padding: 0 28rpx;
  background-color: var(--card-soft-bg);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
  transition: border-color 0.3s ease;
}

.form-picker .placeholder { color: var(--text-light); }
.form-picker .arrow { color: var(--text-light); font-size: 24rpx; }

/* ===== 加载骨架动画 ===== */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, var(--primary-bg) 25%, var(--card-soft-bg) 37%, var(--primary-bg) 63%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 12rpx;
}

.skeleton-text { height: 28rpx; margin-bottom: 12rpx; }
.skeleton-circle { border-radius: 50%; }

/* ===== 页面淡入动画 ===== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in { animation: fadeInUp 0.3s ease-out; }

/* ===== 网络异常 ===== */
.network-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
}

.network-error-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.network-error-text { font-size: 28rpx; color: var(--text-secondary); margin-bottom: 32rpx; }

/* ===== 引导 ===== */
.guide-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
}

.guide-icon { font-size: 120rpx; margin-bottom: 32rpx; }

.guide-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.guide-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 48rpx;
}

/* ===== 彩色渐变 Hero 卡片 ===== */
.hero-purple {
  background: linear-gradient(135deg, var(--primary-gradient-start) 0%, var(--primary-gradient-end) 100%);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  color: #FFFFFF;
  box-shadow: var(--shadow-button);
}
