.pet-header {
  padding: 16rpx 32rpx 0;
}

.pet-header-trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card-bg, #fff);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}

.pet-header-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pet-header-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-bg);
  font-size: 32rpx;
}

.pet-header-info {
  flex: 1;
  min-width: 0;
}

.pet-header-label {
  font-size: 20rpx;
  color: var(--text-secondary, #6B6585);
  line-height: 1.4;
}

.pet-header-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  line-height: 1.4;
}

.pet-header-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.pet-header-arrow.is-open {
  transform: rotate(180deg);
}

/* 遮罩 */
.pet-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 12, 50, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  z-index: 998;
}

.pet-picker-mask.is-show {
  opacity: 1;
  pointer-events: auto;
}

/* bottom sheet */
.pet-picker-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 60vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -12rpx 48rpx rgba(91, 63, 224, 0.16);
  transform: translateY(110%);
  transition: transform 0.3s cubic-bezier(0.22, 0.8, 0.32, 1);
  z-index: 999;
  display: flex;
  flex-direction: column;
}

.pet-picker-sheet.is-show {
  transform: translateY(0);
}

.pet-picker-drag-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.12);
  margin: 20rpx auto 8rpx;
  flex-shrink: 0;
}

.pet-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 20rpx;
  flex-shrink: 0;
}

.pet-picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-color);
}

.pet-picker-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  color: var(--primary-color);
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
}

.pet-picker-list {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
}

.pet-picker-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.pet-picker-item:last-child {
  border-bottom: none;
}

.pet-picker-item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pet-picker-item-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-bg);
  font-size: 36rpx;
}

.pet-picker-item-info {
  flex: 1;
  min-width: 0;
}

.pet-picker-item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pet-picker-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.pet-picker-item-global-tag {
  font-size: 18rpx;
  font-weight: 500;
  color: var(--primary-color);
  background: var(--primary-bg);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.pet-picker-item-role {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  display: block;
}

.pet-picker-item-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary-color);
  color: #fff;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.pet-picker-item.is-active .pet-picker-item-name {
  color: var(--primary-color);
}
