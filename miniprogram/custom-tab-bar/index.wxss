/* 浮动胶囊 TabBar */
.tab-bar {
  position: fixed;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 999;
  border-radius: 999rpx;
  overflow: visible;
  pointer-events: none;
}

.tab-bar-inner {
  pointer-events: auto;
  height: 120rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #F4EFFB;
  border-radius: 999rpx;
  box-shadow: 0 16rpx 40rpx rgba(60, 40, 130, 0.12);
}

.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tab-item-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  transition: all 0.25s ease;
}

/* 激活态：紫色圆角方块背景 + 白色图标 */
.tab-pill {
  /* background-color: #7B5CF5;
  box-shadow: 0 8rpx 18rpx rgba(123, 92, 245, 0.32); */
  filter: invert(18%) sepia(40%) saturate(2400%) hue-rotate(240deg) brightness(60%) contrast(95%);
}

.tab-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  /* 默认：深紫色线性图标 */
  filter: invert(0%) sepia(0%) saturate(2400%) hue-rotate(240deg) brightness(0%) contrast(50%);
  opacity: 0.85;
}

.tab-label {
  font-size: 20rpx;
  color: rgba(94, 95, 93, 1);
  font-weight: 500;
  margin-left: 4rpx;
  white-space: nowrap;
  line-height: 1.5;
  display: none;
}

.tab-pill .tab-label {
}

/* 激活态下方紫色短下划线 */
.tab-underline {
  position: absolute;
  bottom: 0;
  width: 64rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background-color: #7B5CF5;
}

.tab-bar-safe-area {
  height: 0;
}
