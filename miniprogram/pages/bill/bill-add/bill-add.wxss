.page-container {
  padding-bottom: 60rpx;
}

/* 金额输入区 */
.amount-section {
  margin-top: 16rpx;
  text-align: center;
  padding: 48rpx 32rpx;
}

.amount-label {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 24rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-currency {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-right: 8rpx;
}

.amount-input {
  height: 72rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-color);
  text-align: center;
  max-width: 400rpx;
}

/* 表单 */
.form-section {
  margin-top: 16rpx;
}

.required {
  color: #C0392B;
  margin-left: 4rpx;
}

/* 分类选择器 */
.category-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.category-item {
  width: calc(33.33% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background-color: var(--card-soft-bg);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.category-item.active {
  background-color: var(--primary-bg);
  border-color: var(--primary-color);
}

.category-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.category-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.category-item.active .category-label {
  color: var(--primary-color);
  font-weight: 500;
}

/* 提交按钮 */
.btn-section {
  padding: 32rpx 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
}

/* 付款人选择器 */
.payer-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.payer-list {
  display: flex;
  gap: 20rpx;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.payer-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  background: var(--card-soft-bg);
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.payer-item.active {
  border-color: var(--primary-color);
  background: rgba(107, 45, 26, 0.08);
}

.payer-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.payer-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-color);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.payer-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.payer-name.active {
  color: var(--primary-color);
  font-weight: 500;
}