<!-- DGTI 狗格图鉴 - 两列布局 -->
<view class="page">

  <!-- 顶部导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">←</text>
    </view>
    <text class="nav-title">狗格图鉴</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-row">
    <view
      wx:for="{{filterTabs}}"
      wx:key="value"
      class="filter-tab {{activeFilter === item.value ? 'filter-active' : ''}}"
      bindtap="onFilter"
      data-value="{{item.value}}"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 两列网格 -->
  <scroll-view class="scroll-content" scroll-y>
    <view class="atlas-grid">
      <view
        wx:for="{{filtered}}"
        wx:key="id"
        class="atlas-card"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <!-- 顶部：图标 + 稀有度 -->
        <view class="atlas-card-header">
          <image wx:if="{{item.iconImg}}" class="atlas-icon-img" src="{{item.iconImg}}"></image>
          <view wx:else class="atlas-icon" style="background:{{item.iconBg}}">
            <text>🐾</text>
          </view>
          <view class="atlas-rarity" style="background:{{item.rarityBg}};color:{{item.rarityColor}}">
            <text>{{item.rarity}}</text>
          </view>
        </view>
        <!-- 名称 + 代号 -->
        <text class="atlas-name">{{item.name}}</text>
        <text class="atlas-code">{{item.code}}</text>
        <!-- 身份 -->
        <text class="atlas-identity">「{{item.identity}}」</text>
        <!-- 简介 -->
        <text class="atlas-desc">{{item.tagline}}</text>
        <!-- Tag -->
        <view class="atlas-tags">
          <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="atlas-tag" style="background:{{item.rarityBg}}">
            <text>{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="safe-bottom"></view>
  </scroll-view>
</view>
