/* DGTI 狗格图鉴样式 */
page { background-color: #FFF8F6; min-height: 100vh; }

.page {
  min-height: 100vh;
  background: #FFF8F6;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 32rpx 16rpx;
  background: rgba(255, 248, 246, 0.9);
  backdrop-filter: blur(20rpx);
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-icon {
  font-size: 36rpx;
  color: #77321C;
  font-weight: bold;
}
.nav-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #77321C;
}
.nav-placeholder {
  width: 64rpx;
}

/* 筛选标签行 */
.filter-row {
  display: flex;
  flex-direction: row;
  padding: 16rpx 24rpx 24rpx;
  gap: 16rpx;
}
.filter-tab {
  height: 64rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  background: #FFF1ED;
  font-size: 26rpx;
  font-weight: 500;
  color: #54433E;
}
.filter-tab.filter-active {
  background: #77321C;
  color: #fff;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
}

/* 两列网格 */
.atlas-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 20rpx;
}

/* 图鉴卡片 */
.atlas-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(148, 73, 49, 0.06);
  display: flex;
  flex-direction: column;
}

/* 卡片头部 */
.atlas-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.atlas-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.atlas-icon-img {
  width: 72rpx;
  height: 72rpx;
}
.atlas-icon text {
  font-size: 36rpx;
}
.atlas-rarity {
  border-radius: 40rpx;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 900;
  align-self: flex-start;
}

/* 文字 */
.atlas-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #221A17;
  margin-bottom: 2rpx;
}
.atlas-code {
  font-size: 18rpx;
  color: #77321C;
  font-weight: bold;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}
.atlas-identity {
  font-size: 20rpx;
  color: #955131;
  font-style: italic;
  margin-bottom: 6rpx;
}
.atlas-desc {
  font-size: 20rpx;
  color: #54433E;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.atlas-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}
.atlas-tag {
  border-radius: 16rpx;
  padding: 3rpx 12rpx;
  font-size: 16rpx;
  font-weight: bold;
  color: #221B0B;
}

.safe-bottom {
  height: 48rpx;
}
