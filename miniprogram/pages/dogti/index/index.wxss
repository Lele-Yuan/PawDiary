/* DGTI 首页样式 */
page {
  background-color: #FFF8F6;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  background: #FFF8F6;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 32rpx 16rpx;
  background: rgba(255, 248, 246, 0.9);
  backdrop-filter: blur(20rpx);
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-icon {
  font-size: 36rpx;
  color: #77321C;
  font-weight: bold;
}
.nav-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #77321C;
  letter-spacing: 2rpx;
}
.nav-placeholder {
  width: 64rpx;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
  height: calc(100vh - 120rpx);
}

/* Hero 区域 */
.hero-section {
  padding: 40rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-headline {
  width: 100%;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #77321C;
  letter-spacing: -4rpx;
  text-align: center;
  line-height: 1.2;
}
.hero-sub {
  font-size: 28rpx;
  color: #54433E;
  opacity: 0.8;
  font-style: italic;
  margin-top: 12rpx;
  text-align: center;
}

/* 扫描卡 */
.scan-card {
  width: 100%;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 64rpx rgba(148, 73, 49, 0.1);
  margin-bottom: 32rpx;
  background: #FFF1ED;
  position: relative;
}
.scan-dog-image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.8;
}
.scan-card-inner {
  position: relative;
  z-index: 1;
  padding: 32rpx;
  min-height: 400rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.scan-labels {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.scan-status-box {
  width: 180rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  backdrop-filter: blur(8rpx);
}
.scan-bar-1 {
  width: 96rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(119, 50, 28, 0.4);
  margin-bottom: 8rpx;
}
.scan-bar-2 {
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(119, 50, 28, 0.2);
  margin-bottom: 10rpx;
}
.scan-status-text {
  font-size: 18rpx;
  color: #77321C;
  font-weight: bold;
  letter-spacing: 1rpx;
}
.dna-lock-badge {
  background: #F0E0C8;
  border-radius: 40rpx;
  padding: 6rpx 20rpx;
  align-self: flex-start;
}
.dna-lock-text {
  font-size: 18rpx;
  font-weight: 900;
  color: #77321C;
}

/* 狗狗图片区 */
.scan-dog-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}
.scan-dog-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 280rpx;
}
.scan-dog-emoji {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}
.scan-dog-title {
  font-size: 50rpx;
  color: #77321C;
  font-weight: bold;
  margin: 50rpx 0 20rpx 0;
}
.scan-dog-tip {
  font-size: 24rpx;
  color: #ffffff;
}

/* DNA 底部 */
.scan-bottom {
  margin-top: 24rpx;
}
.dna-detect-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.dna-detect-dot {
  font-size: 18rpx;
  color: #77321C;
  margin-right: 8rpx;
}
.dna-detect-label {
  font-size: 18rpx;
  font-weight: bold;
  color: #77321C;
  margin-right: 16rpx;
}
.dna-progress-wrap {
  flex: 1;
  height: 6rpx;
  background: rgba(239, 223, 219, 0.6);
  border-radius: 3rpx;
  overflow: hidden;
}
.dna-progress-bar {
  width: 75%;
  height: 100%;
  background: #77321C;
  border-radius: 3rpx;
}

/* 扫描线 */
.scan-line {
  position: absolute;
  top: 32rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #77321C 50%, transparent 100%);
  box-shadow: 0 0 20rpx rgba(119, 50, 28, 0.8);
}

/* CTA 按钮 */
.cta-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: #77321C;
  border-radius: 64rpx;
  height: 100rpx;
  padding: 0 64rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 16rpx 40rpx rgba(119, 50, 28, 0.25);
  position: relative;
  overflow: hidden;
}
.cta-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  border: 2rpx solid rgba(119, 50, 28, 0.3);
  border-radius: 100%;
}
.cta-btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 16rpx;
}
.cta-btn-arrow {
  font-size: 32rpx;
  color: #fff;
}

/* 研究档案区 */
.archive-section {
  padding: 0 24rpx 40rpx;
}
.archive-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}
.archive-header-left {
  display: flex;
  flex-direction: column;
}
.archive-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #221A17;
  margin-bottom: 4rpx;
}
.archive-subtitle {
  font-size: 22rpx;
  color: #54433E;
  letter-spacing: 4rpx;
}
.archive-more {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.archive-more-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #77321C;
}
.archive-more-arrow {
  font-size: 30rpx;
  color: #77321C;
  margin-left: 4rpx;
}

/* 横向卡片列表 */
.card-scroll {
  width: 100%;
  overflow: hidden;
}
.card-list {
  display: flex;
  flex-direction: row;
  padding-bottom: 32rpx;
  white-space: nowrap;
}
.personality-card {
  width: 260rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 24rpx;
  margin-right: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(148, 73, 49, 0.06);
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: column;
  white-space: normal;
}
.card-icon-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-icon-emoji {
  font-size: 40rpx;
}
.card-icon-img {
  width: 80rpx;
  height: 80rpx;
}
.card-rarity-badge {
  border-radius: 40rpx;
  padding: 4rpx 16rpx;
  font-size: 18rpx;
  font-weight: 900;
  align-self: flex-start;
}
.card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #221A17;
  margin-bottom: 6rpx;
}
.card-identity {
  font-size: 22rpx;
  color: #77321C;
  font-style: italic;
  margin-bottom: 8rpx;
}
.card-desc {
  font-size: 22rpx;
  color: #54433E;
  line-height: 1.6;
  margin-bottom: 16rpx;
  flex: 1;
}
.card-tags {
  display: flex;
  flex-direction: column;
}
.card-tag {
  background: #F0E0C8;
  border-radius: 24rpx;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: bold;
  color: #221B0B;
  align-self: flex-start;
  margin-bottom: 6rpx;
}

/* 5大模型 */
.models-section {
  padding: 0 24rpx 40rpx;
}
.models-header {
  margin-bottom: 20rpx;
}
.models-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #221A17;
  margin-bottom: 4rpx;
  display: block;
}
.models-subtitle {
  font-size: 20rpx;
  color: #54433E;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.models-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}
.model-item {
  width: calc(33.33% - 12rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(148, 73, 49, 0.04);
}
.model-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.model-icon {
  font-size: 36rpx;
}
.model-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #221A17;
  text-align: center;
  margin-bottom: 4rpx;
}
.model-en {
  font-size: 16rpx;
  color: #54433E;
  text-align: center;
}

/* 底部 CTA 卡片 */
.bottom-cta {
  padding: 0 24rpx 40rpx;
}
.bottom-cta-card {
  background: #77321C;
  border-radius: 40rpx;
  padding: 56rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.bottom-cta-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  text-align: center;
}
.bottom-cta-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}
.bottom-cta-btn {
  background: #fff;
  border-radius: 64rpx;
  padding: 20rpx 64rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.bottom-cta-btn-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #77321C;
}

/* 历史测试记录 */
.history-section {
  padding: 0 24rpx 40rpx;
}
.history-header {
  margin-bottom: 20rpx;
}
.history-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #221A17;
  display: block;
  margin-bottom: 4rpx;
}
.history-subtitle {
  font-size: 22rpx;
  color: #54433E;
  letter-spacing: 4rpx;
}
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.history-item {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(148, 73, 49, 0.04);
}
.history-item-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 20rpx 12rpx;
}
.history-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.history-icon text {
  font-size: 32rpx;
}
.history-info {
  flex: 1;
}
.history-info-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 4rpx;
}
.history-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #221A17;
  margin-right: 10rpx;
}
.history-rarity {
  border-radius: 24rpx;
  padding: 2rpx 12rpx;
  font-size: 16rpx;
  font-weight: 900;
}
.history-identity {
  font-size: 22rpx;
  color: #955131;
  font-style: italic;
}
.history-arrow {
  font-size: 32rpx;
  color: #ADA19A;
  margin-left: 8rpx;
}
.history-item-bottom {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 20rpx 12rpx;
  border-top: 1rpx solid rgba(218, 193, 186, 0.15);
}
.history-time {
  font-size: 20rpx;
  color: #ADA19A;
}
.history-delete {
  font-size: 22rpx;
  color: #77321C;
  opacity: 0.6;
  padding: 4rpx 0;
}

.safe-bottom {
  height: 48rpx;
}
