/* DGTI 答题页样式 */
page {
  background-color: #FFF8F6;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  background: #FFF8F6;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 32rpx 16rpx;
  background: rgba(255, 248, 246, 0.9);
  backdrop-filter: blur(20rpx);
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.nav-back-icon {
  font-size: 36rpx;
  color: #77321C;
  font-weight: bold;
  margin-right: 12rpx;
}
.nav-logo {
  font-size: 30rpx;
  font-weight: bold;
  color: #77321C;
  letter-spacing: 2rpx;
}
.nav-right {
  width: 64rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.nav-menu {
  font-size: 28rpx;
  color: #54433E;
  letter-spacing: 4rpx;
}

/* 进度区域 */
.progress-section {
  padding: 16rpx 48rpx 32rpx;
}
.progress-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
}
.progress-header-left {
  min-height: 40rpx;
}
.prev-btn-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #77321C;
  opacity: 0.7;
  padding: 4rpx 0;
}
.progress-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #77321C;
  letter-spacing: 4rpx;
}
.progress-count {
  font-size: 28rpx;
  font-weight: bold;
  color: #955131;
}
.progress-track {
  width: 100%;
  height: 10rpx;
  background: #EFDDD B;
  border-radius: 5rpx;
  overflow: hidden;
  background: #EFDDDB;
}
.progress-fill {
  height: 100%;
  background: #77321C;
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
}

/* 题目包装 */
.question-wrap {
  padding: 0 24rpx 80rpx;
  position: relative;
}

/* 装饰爪印 */
.deco-paw {
  position: absolute;
  top: 24rpx;
  right: 40rpx;
  font-size: 80rpx;
  opacity: 0.15;
  z-index: 0;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  border-radius: 48rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 64rpx rgba(148, 73, 49, 0.1);
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

/* 情境图区域 */
.question-image-area {
  position: relative;
  height: 340rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF1ED 0%, #F0E0C8 100%);
}
.question-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.question-image-emoji {
  font-size: 120rpx;
}
.question-image-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(0deg, #fff 0%, transparent 100%);
}

/* 题目内容区 */
.question-body {
  padding: 24rpx 48rpx 56rpx;
}
.question-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #221A17;
  text-align: center;
  display: block;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.option-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #FFF1ED;
  border-radius: 48rpx;
  padding: 0 32rpx;
  height: 108rpx;
  transition: all 0.2s ease;
}
.option-item.option-selected {
  background: #77321C;
}
.option-letter-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(119, 50, 28, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.option-letter-wrap.letter-selected {
  border-color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.2);
}
.option-letter {
  font-size: 28rpx;
  font-weight: bold;
  color: #77321C;
}
.option-item.option-selected .option-letter {
  color: #fff;
}
.option-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #54433E;
}
.option-item.option-selected .option-label {
  color: #fff;
}

/* 底部语录 */
.quote-area {
  padding: 0 16rpx;
  opacity: 0.7;
}
.quote-text {
  font-size: 24rpx;
  color: #877 36D;
  text-align: center;
  font-style: italic;
  line-height: 1.7;
  display: block;
  color: #87736D;
}
