.page {
  min-height: 100vh;
  background: #F6F3FF;
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  background: #fff;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #7B5CF5;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #7B5CF5;
  border-radius: 2rpx;
}

.tab-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
  font-weight: 400;
}

.list {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 0;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.row:last-child {
  border-bottom: none;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 20rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.role-tag {
  display: inline-block;
  width: fit-content;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  line-height: 1.6;
}

.tag-creator {
  background: #fff5e6;
  color: #d97a16;
}

.tag-admin {
  background: #ede7ff;
  color: #7B5CF5;
}

.tag-member {
  background: #f0f0f0;
  color: #666;
}

.actions {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: #f0f0f0;
  color: #555;
}

.btn.primary {
  background: #7B5CF5;
  color: #fff;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}
