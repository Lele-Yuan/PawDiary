.pet-hero {
  position: relative;
  margin: 0;
  padding: 0 32rpx 44rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  background: linear-gradient(145deg, #ab8ad5 0%, #ebcffa 52%, #9978c3 100%);
  box-shadow: 0 18rpx 40rpx rgba(139, 107, 247, 0.22);
}

.hero-safe-space {
  position: relative;
  z-index: 1;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-deco-top {
  top: -140rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(255, 255, 255, 0.18);
}

.hero-deco-bottom {
  bottom: -180rpx;
  left: -140rpx;
  width: 420rpx;
  height: 420rpx;
  background: rgba(255, 221, 209, 0.26);
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-top: 24rpx;
}

.hero-caption {
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-bottom: 18rpx;
}

.hero-name-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding-right: 8rpx;
}

.hero-name {
  font-size: 64rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #FFFFFF;
  word-break: break-all;
}

.hero-name-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
  transition: transform 0.25s ease;
}

.hero-name-arrow.is-open {
  transform: rotate(180deg);
}

.hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 36rpx;
}

.hero-meta-text,
.hero-meta-dot {
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.84);
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-stat {
  min-width: 148rpx;
  padding: 16rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(14rpx);
}

.hero-stat-value {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-stat-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.hero-stat-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.72);
}

.hero-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  margin-top: 18rpx;
}

.hero-avatar {
  width: 220rpx;
  height: 220rpx;
  display: block;
  border-radius: 52rpx;
  transform: rotate(6deg);
  background: rgba(255, 255, 255, 0.18);
  box-shadow: 0 20rpx 32rpx rgba(138, 55, 66, 0.18);
}

.gender-badge {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #FFFFFF;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
}

.gender-badge.male {
  background-color: #3C6663;
}

.gender-badge.female {
  background-color: #EC4899;
}

/* 宠物切换抽屉 */
.pet-drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 12, 50, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  z-index: 998;
}

.pet-drawer-mask.is-show {
  opacity: 1;
  pointer-events: auto;
}

.pet-drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 78%;
  max-width: 600rpx;
  padding: 0 28rpx 40rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 8rpx 0 36rpx rgba(91, 63, 224, 0.18);
  border-radius: 0 36rpx 36rpx 0;
  transform: translateX(-105%);
  transition: transform 0.28s cubic-bezier(0.22, 0.8, 0.32, 1);
  z-index: 999;
  display: flex;
  flex-direction: column;
}

.pet-drawer.is-show {
  transform: translateX(0);
}

.pet-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx 20rpx;
}

.pet-drawer-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary, #2A1F5C);
  letter-spacing: 1rpx;
}

.pet-drawer-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(123, 92, 245, 0.12);
  color: var(--primary-color, #7B5CF5);
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
}

.pet-drawer-list {
  flex: 1;
  min-height: 0;
}

.pet-drawer-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 16rpx;
  margin-bottom: 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  transition: background 0.2s ease;
}

.pet-drawer-item.is-active {
  background: linear-gradient(135deg, rgba(123, 92, 245, 0.16), rgba(164, 139, 250, 0.18));
  box-shadow: 0 8rpx 18rpx rgba(123, 92, 245, 0.12);
}

.pet-drawer-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  background: rgba(123, 92, 245, 0.08);
}

.pet-drawer-info {
  flex: 1;
  min-width: 0;
}

.pet-drawer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, #2A1F5C);
  line-height: 1.3;
}

.pet-drawer-age {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6E6790);
}

.pet-drawer-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary-color, #7B5CF5);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 叹号备注按钮 */
.hero-remarks-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.28);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* 备注浮层遮罩 */
.remarks-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 12, 50, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  z-index: 998;
}

.remarks-sheet-mask.is-show {
  opacity: 1;
  pointer-events: auto;
}

/* 备注 bottom sheet */
.remarks-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 62rpx);
  box-shadow: 0 -12rpx 48rpx rgba(91, 63, 224, 0.16);
  transform: translateY(110%);
  transition: transform 0.3s cubic-bezier(0.22, 0.8, 0.32, 1);
  z-index: 999;
  display: flex;
  flex-direction: column;
}

.remarks-sheet.is-show {
  transform: translateY(0);
}

.remarks-sheet-drag-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.12);
  margin: 20rpx auto 8rpx;
  flex-shrink: 0;
}

.remarks-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 20rpx;
  flex-shrink: 0;
}

.remarks-sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary, #2A1F5C);
}

.remarks-sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(123, 92, 245, 0.1);
  color: var(--primary-color, #7B5CF5);
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
}

.remarks-sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 32rpx;
}

.remark-sheet-item {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: rgba(123, 92, 245, 0.05);
  border: 1rpx solid rgba(123, 92, 245, 0.1);
}

.remark-sheet-type {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.remark-sheet-icon {
  font-size: 28rpx;
  line-height: 1;
}

.remark-sheet-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color, #7B5CF5);
}

.remark-sheet-content {
  font-size: 28rpx;
  color: var(--text-primary, #2A1F5C);
  line-height: 1.6;
}

.remarks-sheet-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary, #6E6790);
}
