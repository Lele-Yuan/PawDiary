@import "../mealtime-theme.wxss";

/* pages/family/family.wxss */
.fam-name { font-size: 40rpx; font-weight: 700; }

.invite {
  display: flex; align-items: center; background: #fff;
  border-radius: 18rpx; padding: 22rpx 28rpx; margin-top: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(123,92,245,0.12);
}
.invite .lab { color: var(--c-sub); font-size: 24rpx; }
.invite .code {
  font-size: 40rpx; font-weight: 700; letter-spacing: 6rpx;
  color: var(--c-primary-deep); margin-left: 20rpx; flex: 1;
}
.invite .copy { color: var(--c-primary); font-size: 24rpx; }

.me-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx;
}
.switch {
  background: #fff; color: var(--c-primary-deep);
  border: 2rpx solid var(--c-primary-light);
  border-radius: 999rpx; padding: 10rpx 24rpx; font-size: 24rpx;
}

/* 入口 */
.entries { display: flex; padding: 24rpx 24rpx 0; }
.entry {
  flex: 1; background: #fff; border-radius: 22rpx; padding: 28rpx 20rpx;
  margin: 0 8rpx; text-align: center; box-shadow: 0 8rpx 24rpx rgba(123,92,245,0.08);
}
.entry.main { background: var(--grad-primary); }
.entry.main .et, .entry.main .es { color: #fff; }
.entry .ic { font-size: 48rpx; }
.entry .et { font-weight: 600; margin-top: 12rpx; }
.entry .es { font-size: 22rpx; color: var(--c-sub); margin-top: 6rpx; }

/* 成员行 */
.mem-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid var(--c-line); }
.mem-row:last-child { border-bottom: none; }
.mem-info { margin-left: 20rpx; }
.mem-name { font-size: 30rpx; font-weight: 600; }
.mini { font-size: 24rpx; margin-left: 6rpx; }

/* 邀请操作行 */
.invite-actions { display: flex; align-items: center; margin-top: 20rpx; }
.inv-btn {
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600; border-radius: 999rpx;
  padding: 18rpx 0; line-height: 1.2;
}
.inv-btn.share {
  flex: 1; background: var(--grad-primary); color: #fff; margin: 0;
  box-shadow: 0 8rpx 20rpx rgba(123,92,245, 0.32);
}
.inv-btn.share::after { border: none; }
.inv-btn.ghost {
  background: #fff; color: var(--c-primary-deep);
  border: 2rpx solid var(--c-primary-light);
  padding: 16rpx 28rpx; margin-left: 16rpx;
}

/* 危险操作 */
.danger-zone { padding: 12rpx 32rpx 48rpx; }
.danger-btn {
  text-align: center; background: #fff; color: #f97e54;
  border: 2rpx solid #FCE6EE; border-radius: 999rpx;
  padding: 22rpx 0; font-size: 28rpx; font-weight: 600;
}

/* 编辑弹窗 */
.mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center; z-index: 99;
}
.modal {
  width: 600rpx; background: #fff; border-radius: 28rpx; padding: 44rpx 40rpx;
}
.modal-t { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 32rpx; }
.field {
  background: #F8F5FF; border-radius: 16rpx; padding: 24rpx 28rpx; font-size: 28rpx;
}
.switch-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx; font-size: 28rpx; color: var(--c-text);
}
