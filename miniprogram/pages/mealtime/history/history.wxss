@import "../mealtime-theme.wxss";

/* pages/history/history.wxss */
.h-card { transition: transform .1s; }
.h-card:active { transform: scale(0.98); }
.h-title { font-size: 32rpx; font-weight: 700; }
.emojis { margin: 18rpx 0; font-size: 40rpx; }
.emojis .e { margin-right: 8rpx; }
.h-meta { margin-top: 8rpx; }
.dur { color: var(--c-primary-deep); font-weight: 600; font-size: 26rpx; }

/* 成员头像行 */
.ava-row { display: flex; align-items: center; margin-top: 18rpx; }
.ava {
  width: 52rpx; height: 52rpx; border-radius: 50%; margin-right: -12rpx;
  background: #EFEAFE; border: 3rpx solid #fff; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: var(--c-primary-deep);
}
.ava image { width: 100%; height: 100%; }
.ava-lbl { margin-left: 24rpx; font-size: 22rpx; color: var(--c-sub); }
