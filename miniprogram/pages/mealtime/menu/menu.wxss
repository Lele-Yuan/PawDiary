@import "../mealtime-theme.wxss";

/* pages/menu/menu.wxss */
.page-head .t { font-size: 36rpx; font-weight: 700; }
.count {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--grad-primary); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700;
}

.list { padding: 8rpx 0; }
.dish-card {
  display: flex; background: #fff; border-radius: 24rpx;
  margin: 20rpx 32rpx; overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(123,92,245,0.08);
}
.dish-img {
  width: 180rpx; height: 180rpx; background: #EFEAFE; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.dish-img image { width: 100%; height: 100%; }
.ph-ic { font-size: 64rpx; }
.dish-body { flex: 1; padding: 20rpx 24rpx; }
.dish-name { font-size: 32rpx; font-weight: 700; }
.del { color: #e05656; font-size: 24rpx; }
.ings { margin-top: 12rpx; }
.taste { font-size: 22rpx; color: #d98a00; margin-left: 14rpx; }

.fab {
  position: fixed; left: 32rpx; right: 32rpx; bottom: 36rpx;
  background: var(--grad-primary); color: #fff; text-align: center;
  font-size: 32rpx; font-weight: 600; padding: 26rpx 0; border-radius: 999rpx;
  box-shadow: 0 12rpx 28rpx rgba(123,92,245,0.36);
}
