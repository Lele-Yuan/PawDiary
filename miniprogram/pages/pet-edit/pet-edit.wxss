.page-container {
  padding-bottom: 60rpx;
}

/* 添加模式系统提示 */
.add-tip {
  display: flex;
  align-items: flex-start;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--card-soft-bg);
  border: 1rpx solid rgba(232, 135, 90, 0.2);
  border-radius: 16rpx;
}

.add-tip-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.add-tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.add-tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 6rpx;
}

.add-tip-desc {
  font-size: 24rpx;
  color: #6B5C4D;
  line-height: 1.6;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-color);
  box-shadow: 0 8rpx 24rpx rgba(232, 135, 90, 0.25);
}

.avatar-tip {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-top: 16rpx;
}

/* 表单区域 */
.form-section {
  margin-top: 12rpx;
}

.required {
  color: #C0392B;
  margin-left: 4rpx;
}

/* 物种选择器 */
.species-selector {
  display: flex;
  gap: 20rpx;
}

.species-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background-color: var(--card-soft-bg);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.species-item.active {
  background-color: rgba(107, 45, 26, 0.1);
  border-color: var(--primary-color);
}

.species-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.species-label {
  font-size: 24rpx;
  color: #6B6B80;
}

.species-item.active .species-label {
  color: var(--primary-color);
  font-weight: 500;
}

/* 性别选择器 */
.gender-selector {
  display: flex;
  gap: 20rpx;
}

.gender-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: var(--card-soft-bg);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.gender-item.active {
  background-color: rgba(107, 45, 26, 0.1);
  border-color: var(--primary-color);
}

.gender-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.gender-label {
  font-size: 28rpx;
  color: #6B6B80;
}

.gender-item.active .gender-label {
  color: var(--primary-color);
  font-weight: 500;
}

/* 按钮区域 */
.btn-section {
  padding: 16rpx 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
}

.archive-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  color: #888888;
  border-color: #CCCCCC;
}

.archive-btn::after {
  border: none;
}

/* 备注模块 */
.remark-section {
  margin-top: 12rpx;
}

.remark-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.remark-title {
  margin-bottom: 0;
}

.remark-count {
  font-size: 24rpx;
  color: var(--text-secondary, #6E6790);
}

.remark-list {
  margin-bottom: 16rpx;
}

.remark-item {
  padding: 16rpx 0 4rpx;
}

.remark-divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin: 16rpx 0 0;
}

/* 类型标签横向滚动 */
.remark-type-scroll {
  width: 100%;
  margin-bottom: 16rpx;
}

.remark-type-row {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.remark-type-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6E6790);
  background: var(--card-soft-bg, #F5F0FF);
  border: 2rpx solid transparent;
  white-space: nowrap;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.remark-type-tag.active {
  color: var(--primary-color);
  background: rgba(107, 45, 26, 0.08);
  border-color: var(--primary-color);
  font-weight: 500;
}

/* 自定义类型输入框 */
.remark-custom-type-input {
  margin-bottom: 12rpx;
  background: var(--card-soft-bg, #F5F0FF);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

/* 内容区域（textarea + 删除） */
.remark-content-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.remark-textarea {
  flex: 1;
  min-height: 80rpx;
  padding: 16rpx 20rpx;
  background: var(--card-soft-bg, #F5F0FF);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-primary, #2A1F5C);
  line-height: 1.6;
}

.remark-delete {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(244, 67, 54, 0.1);
  color: #F44336;
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
  flex-shrink: 0;
  margin-top: 8rpx;
}

/* 添加备注按钮 */
.remark-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: 2rpx dashed var(--primary-color);
  color: var(--primary-color);
  font-size: 28rpx;
  background: rgba(107, 45, 26, 0.04);
}

.remark-add-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.remark-add-icon {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}