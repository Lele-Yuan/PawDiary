page {
  background-color: var(--bg-color);
}

.trends-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.trends-content {
  padding: 0 32rpx;
}

/* 顶部宠物头部卡片 */
.hero-card {
  background: linear-gradient(135deg, #7B5CF5 0%, #5A3FE0 100%);
  border-radius: 36rpx;
  padding: 36rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(123, 92, 245, 0.28);
}

.hero-meta {
  display: flex;
  flex-direction: column;
}

.hero-date {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.15;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  font-size: 48rpx;
  font-style: italic;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1.2;
  margin-bottom: 28rpx;
}

.hero-stats {
  display: flex;
  gap: 12rpx;
}

.hero-stat {
  flex: 1;
  background-color: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 16rpx 18rpx;
  display: flex;
  flex-direction: column;
}

.hero-stat-label {
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}

.hero-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 时间区间切换 */
.range-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.range-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-color);
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 14rpx 0;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(123, 92, 245, 0.06);
}

.range-tab.active {
  background-color: var(--primary-color);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(123, 92, 245, 0.28);
}

.range-tab-arrow {
  font-size: 28rpx;
  line-height: 1;
}

.custom-range-tip {
  text-align: center;
  font-size: 24rpx;
  color: #888888;
  margin: -8rpx 0 16rpx;
}

/* 图表卡片 */
.chart-card {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.chart-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-color);
  letter-spacing: -0.5rpx;
  display: block;
  margin-bottom: 16rpx;
}

.chart-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #999999;
  margin-left: 6rpx;
  letter-spacing: 0;
}

.chart-legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx 22rpx;
  margin-bottom: 12rpx;
}

.chart-legend-wrap {
  gap: 8rpx 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #666666;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.legend-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.chart-canvas {
  width: 100%;
  display: block;
}

.chart-canvas-line {
  height: 360rpx;
}

.chart-canvas-heat {
  height: 320rpx;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #BBBBBB;
  padding: 80rpx 0;
}
