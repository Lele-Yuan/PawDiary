.ad-page {
  min-height: 100vh;
}

/* 封面 */
.ad-cover {
  /* background: linear-gradient(135deg, #7C6FCD 0%, #A99FE0 100%); */
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}
.ad-cover-emoji {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 130rpx;
  opacity: 0.18;
}
.ad-cover-actions {
  position: absolute;
  right: 32rpx;
  bottom: 0;
  display: flex;
  gap: 16rpx;
}
.ad-cover-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.ad-cover-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.ad-cover-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 6rpx;
}

/* 成员行 */
.ad-members {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  /* background: #fff; */
  overflow-x: auto;
  white-space: nowrap;
}
.ad-members-lbl {
  font-size: 24rpx;
  color: #7A74A0;
  flex-shrink: 0;
}
.ad-member {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.ad-member-av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #7C6FCD;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
.ad-member-nm {
  font-size: 20rpx;
  color: #7A74A0;
}
.ad-member-add {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx dashed #A99FE0;
  color: #A99FE0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.ad-member-manage {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 24rpx;
  color: #7C6FCD;
  background: #F0EEFF;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
}

/* Tab */
.ad-tabs {
  display: flex;
  /* background: #fff; */
  padding: 8rpx;
  /* border-bottom: 1rpx solid #EDE9FF; */
}
.ad-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #7A74A0;
  border-radius: 12rpx;
}
.ad-tab.active {
  background: linear-gradient(135deg, #7C6FCD 0%, #A99FE0 100%);
  color: #fff;
  font-weight: 600;
}

.ad-body {
  padding: 24rpx 32rpx 60rpx;
}
.ad-empty {
  text-align: center;
  color: #B8B3D8;
  font-size: 26rpx;
  padding: 80rpx 0;
}
/* WXSS_MORE_PLACEHOLDER */

/* 账单 */
.ad-date-sep {
  font-size: 22rpx;
  color: #B8B3D8;
  padding: 16rpx 8rpx 10rpx;
}
.ad-bill-cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2px 8px rgba(124, 111, 205, 0.1);
}
.ad-bill-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #F0EEFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.ad-bill-info { flex: 1; }
.ad-bill-name { font-size: 28rpx; font-weight: 600; color: #2D2755; }
.ad-bill-sub { font-size: 22rpx; color: #7A74A0; margin-top: 6rpx; }
.ad-bill-right { text-align: right; }
.ad-bill-amt { font-size: 30rpx; font-weight: 700; color: #2D2755; }
.ad-bill-per { font-size: 20rpx; color: #7A74A0; margin-top: 4rpx; }
.ad-add-btn {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
  background: linear-gradient(135deg, #7C6FCD 0%, #A99FE0 100%);
  color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6px 20rpx rgba(124, 111, 205, 0.4);
}

/* 结算 */
.ad-balance {
  background: linear-gradient(135deg, #7C6FCD 0%, #A99FE0 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.ad-balance-hd { font-size: 24rpx; opacity: 0.85; margin-bottom: 16rpx; }
.ad-bal-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 10rpx;
  opacity: 0.9;
}
.ad-bal-net {
  display: flex;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}
.ad-bal-net .pos { color: #b0f7cf; }
.ad-bal-net .neg { color: #ffd6d6; }
.ad-settled {
  background: linear-gradient(135deg, #07C160, #52C41A);
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}
.ad-settled-ico { font-size: 56rpx; }
.ad-settled-t { font-size: 28rpx; font-weight: 700; margin-top: 8rpx; }
.ad-sec-title { font-size: 22rpx; color: #7A74A0; font-weight: 600; padding: 8rpx 8rpx 14rpx; }
.ad-settle-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ad-recalc-btn {
  font-size: 22rpx;
  color: #7C6FCD;
  padding: 8rpx 20rpx;
  background: #F0EEFF;
  border-radius: 20rpx;
}
.ad-settle-cell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2px 8px rgba(124, 111, 205, 0.1);
}
.ad-settle-info { flex: 1; }
.ad-settle-nm { font-size: 26rpx; font-weight: 600; color: #2D2755; }
.ad-settle-amt { font-size: 30rpx; font-weight: 700; color: #7C6FCD; margin-top: 4rpx; }
.ad-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #EDE9FF;
  color: #B8B3D8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
.ad-check.done {
  background: #07C160;
  border-color: #07C160;
  color: #fff;
}
.ad-progress {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 8rpx;
}
.ad-prog-hd {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #7A74A0;
  margin-bottom: 12rpx;
}
.ad-prog-hd .c { color: #7C6FCD; font-weight: 600; }
.ad-prog-track { height: 12rpx; background: #EDE9FF; border-radius: 6rpx; overflow: hidden; }
.ad-prog-fill { height: 100%; background: linear-gradient(135deg, #7C6FCD, #A99FE0); }

/* 统计 */
.ad-stat-head {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 20rpx;
}
.ad-stat-item { flex: 1; text-align: center; }
.ad-stat-item .v { font-size: 34rpx; font-weight: 700; color: #7C6FCD; }
.ad-stat-item .l { font-size: 22rpx; color: #7A74A0; margin-top: 4rpx; }
.ad-chart-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.ad-chart-hd { font-size: 28rpx; font-weight: 600; color: #2D2755; margin-bottom: 20rpx; }
.ad-bar-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.ad-bar-nm { width: 130rpx; font-size: 22rpx; color: #7A74A0; text-align: right; flex-shrink: 0; }
.ad-bar-track { flex: 1; height: 36rpx; background: #F5F3FF; border-radius: 18rpx; overflow: hidden; }
.ad-bar-fill {
  height: 100%;
  min-width: 60rpx;
  background: linear-gradient(135deg, #7C6FCD, #A99FE0);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 12rpx;
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}
.ad-bar-pct { width: 60rpx; font-size: 20rpx; color: #7A74A0; flex-shrink: 0; }

/* SHEET_PLACEHOLDER */

/* 弹层 */
.ad-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.ad-sheet {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.ad-sheet-bar {
  width: 64rpx;
  height: 8rpx;
  background: #DDD;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}
.ad-sheet-hd {
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2755;
  padding: 24rpx;
  border-bottom: 1rpx solid #EDE9FF;
}
.ad-sheet-scroll { max-height: 60vh; }
.ad-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 24rpx;
}
.ad-cat-cell { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.ad-cat-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #F5F3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border: 4rpx solid transparent;
}
.ad-cat-cell.sel .ad-cat-ic { background: #D4CEFF; border-color: #7C6FCD; }
.ad-cat-lb { font-size: 22rpx; color: #7A74A0; }
.ad-amt-area {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #EDE9FF;
}
.ad-amt-prefix { font-size: 44rpx; color: #B8B3D8; }
.ad-amt-input {
  height: 60rpx;
  font-size: 60rpx;
  font-weight: 600;
  color: #7C6FCD;
  text-align: center;
  min-width: 200rpx;
}
.ad-form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #EDE9FF;
}
.ad-form-lbl { font-size: 26rpx; color: #7A74A0; width: 130rpx; flex-shrink: 0; }
.ad-form-input { flex: 1; font-size: 28rpx; color: #2D2755; }
.ad-payer-scroll { flex: 1; white-space: nowrap; }
.ad-payer {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  border: 2rpx solid #EDE9FF;
  font-size: 24rpx;
  color: #7A74A0;
}
.ad-payer.sel { border-color: #7C6FCD; background: #D4CEFF; color: #7C6FCD; }
.ad-msel { padding: 20rpx 32rpx; }
.ad-mchips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.ad-mchip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  border: 2rpx solid #EDE9FF;
  font-size: 24rpx;
  color: #7A74A0;
}
.ad-mchip.sel { border-color: #7C6FCD; background: #D4CEFF; color: #7C6FCD; }
.ad-split-input {
  width: 100rpx;
  font-size: 24rpx;
  border-bottom: 2rpx solid #7C6FCD;
  text-align: center;
}
.ad-save-btn {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #7C6FCD 0%, #A99FE0 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx;
}
.ad-invite-tip {
  text-align: center;
  font-size: 24rpx;
  color: #7A74A0;
  padding: 24rpx 40rpx 12rpx;
}
.ad-invite-code {
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #7C6FCD;
  letter-spacing: 4rpx;
  padding: 12rpx 0 24rpx;
}
.ad-share-btn {
  margin: 12rpx 32rpx;
  background: #07C160;
  color: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx;
}
.ad-copy-btn {
  margin: 12rpx 32rpx;
  background: #F5F3FF;
  color: #7C6FCD;
  border-radius: 20rpx;
  font-size: 28rpx;
  padding: 20rpx;
}

/* 邀请加入未登录阻断态 */
.ad-login-guard {
  min-height: 100vh;
  background: #F5F3FF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.ad-guard-icon { font-size: 120rpx; margin-bottom: 24rpx; }
.ad-guard-title { font-size: 34rpx; font-weight: 700; color: #2D2755; }
.ad-guard-sub {
  font-size: 26rpx;
  color: #7A74A0;
  text-align: center;
  margin-top: 16rpx;
  line-height: 1.6;
}
.ad-guard-btn {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #7C6FCD 0%, #A99FE0 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 80rpx;
}

/* 成员管理弹层 */
.ad-manage-tip {
  text-align: center;
  font-size: 22rpx;
  color: #7A74A0;
  padding: 16rpx 40rpx 8rpx;
}
.ad-manage-list {
  max-height: 60vh;
}
.ad-manage-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #EDE9FF;
}
.ad-manage-av {
  flex-shrink: 0;
}
.ad-manage-av-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #7C6FCD;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
.ad-manage-info {
  flex: 1;
  min-width: 0;
}
.ad-manage-nm {
  font-size: 28rpx;
  color: #2D2755;
  font-weight: 600;
}
.ad-manage-role {
  font-size: 20rpx;
  margin-top: 6rpx;
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  color: #7A74A0;
  background: #F5F3FF;
}
.ad-manage-role.role-creator { color: #7C6FCD; background: #D4CEFF; }
.ad-manage-role.role-admin { color: #FF8C42; background: #FFF0E4; }
.ad-manage-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FA5151;
  padding: 10rpx 24rpx;
  border: 2rpx solid #FA5151;
  border-radius: 24rpx;
}
