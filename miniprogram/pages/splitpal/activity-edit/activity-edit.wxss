.ae-page {
  min-height: 100vh;
  background: #F5F3FF;
  padding: 32rpx;
}
.ae-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2px 8px rgba(124, 111, 205, 0.12);
}
.ae-label {
  font-size: 26rpx;
  color: #7A74A0;
  margin-bottom: 20rpx;
}
.ae-input {
  font-size: 32rpx;
  color: #2D2755;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #EDE9FF;
}
.ae-emoji-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
}
.ae-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #F5F3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 3rpx solid transparent;
}
.ae-emoji.sel {
  background: #D4CEFF;
  border-color: #7C6FCD;
}
.ae-save-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #7C6FCD 0%, #A99FE0 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx;
  box-shadow: 0 6px 20px rgba(124, 111, 205, 0.35);
}
.ae-save-btn[disabled] {
  opacity: 0.6;
}
