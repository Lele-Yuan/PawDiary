.bill-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin: 16rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(123, 92, 245, 0.08);
}
.head { display: flex; align-items: center; gap: 20rpx; }
.emoji { font-size: 48rpx; }
.meta { flex: 1; display: flex; flex-direction: column; }
.title { font-size: 30rpx; color: #1F1A3D; font-weight: 500; }
.sub { font-size: 24rpx; color: #6B6585; margin-top: 4rpx; }
.amount { font-size: 36rpx; font-weight: 600; color: #7B5CF5; }
.footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EFEAFE;
  display: flex;
  justify-content: space-between;
}
.date { font-size: 22rpx; color: #B5B0C8; }
.note { font-size: 22rpx; color: #6B6585; }
