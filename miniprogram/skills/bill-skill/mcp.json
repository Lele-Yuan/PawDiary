{
  "apis": [
    {
      "name": "addBill",
      "description": "为宠物新增一笔消费账单。当用户说\"记一笔\"\"花了多少\"\"买了xx多少钱\"等并给出明确金额时调用。amount 必须用户明确给出的具体数值，模糊表达需先反问澄清。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string", "description": "宠物名字。用户在话语中明确提到时必须填写；未提到时不要填写。禁止编造。" },
          "amount": { "type": "number", "description": "消费金额，单位元。必须为用户明确给出的数值。" },
          "category": {
            "type": "string",
            "enum": ["food","medical","toy","grooming","daily","other"],
            "description": "分类。food=食物（狗粮/猫粮/零食）, medical=医疗（看病/疫苗/驱虫药）, toy=玩具, grooming=美容（洗澡/造型）, daily=日用（猫砂/牵引绳/项圈等）, other=其他。"
          },
          "title": { "type": "string", "description": "简短描述，例如\"狗粮\"\"疫苗\"。" },
          "date": { "type": "string", "description": "消费日期 ISO 字符串。未提日期时使用今天。" },
          "note": { "type": "string", "description": "备注。" }
        },
        "required": ["amount", "category", "title"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "petName": { "type": "string" },
          "amount": { "type": "number" },
          "category": { "type": "string" },
          "categoryName": { "type": "string" },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "_meta": { "ui": { "componentPath": "components/bill-card" } }
    },
    {
      "name": "listBills",
      "description": "查询账单明细列表。用户问\"看看最近的账单\"\"3 月份花了哪些\"等场景调用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string", "description": "宠物名字。规则同 addBill。" },
          "year": { "type": "number", "description": "年份。" },
          "month": { "type": "number", "description": "月份 1-12。" },
          "limit": { "type": "number", "description": "上限，默认 20。" }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string" },
          "year": { "type": "number" },
          "month": { "type": "number" },
          "total": { "type": "number" },
          "bills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": { "type": "string" },
                "amount": { "type": "number" },
                "category": { "type": "string" },
                "categoryName": { "type": "string" },
                "title": { "type": "string" },
                "date": { "type": "string" }
              }
            }
          }
        }
      },
      "_meta": { "ui": { "componentPath": "components/bill-list-card" } }
    },
    {
      "name": "getMonthlyStats",
      "description": "查询月度账单统计（总额、分类占比、环比上月）。用户问\"这个月花了多少\"\"上月医疗多少钱\"等场景调用。禁止用 listBills 自行求和。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string", "description": "宠物名字。规则同 addBill。" },
          "year": { "type": "number", "description": "年份，缺省当年。" },
          "month": { "type": "number", "description": "月份，缺省当月。" },
          "trend": { "type": "boolean", "description": "是否返回近 6 个月趋势。" }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string" },
          "year": { "type": "number" },
          "month": { "type": "number" },
          "monthTotal": { "type": "number" },
          "lastMonthTotal": { "type": "number" },
          "categoryStats": { "type": "array" },
          "trends": { "type": "array" }
        }
      },
      "_meta": { "ui": { "componentPath": "components/bill-stats-card" } }
    }
  ],
  "components": [
    { "path": "components/bill-card" },
    { "path": "components/bill-list-card" },
    { "path": "components/bill-stats-card" }
  ]
}
