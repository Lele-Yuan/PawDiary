    {
      "name": "listFamilyDishes",
      "description": "查询选定来吃饭家庭的共享菜单，支持菜名关键词。耗时单位分钟，不提供过敏安全保证，不执行点菜。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "familyId": {
            "type": "string",
            "description": "必须来自 listMealFamilies.families[]._id，是来吃饭的家庭 ID，不能使用宠物 ID。多项时由用户选择。"
          },
          "keyword": {
            "type": "string",
            "description": "用户提供的菜名关键词，默认不过滤。"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20,
            "description": "本次最多返回条数，默认20，上限50。不代表全部历史。"
          }
        },
        "required": [
          "familyId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "familyId": {
            "type": "string"
          },
          "dishes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string"
                },
                "dishId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "duration": {
                  "type": "number"
                },
                "remark": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "ingredients": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "emoji": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                },
                "tastes": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "emoji": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "durationUnit": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "页面入口的展示文字。"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "title",
            "description": "真实小程序页面入口，由用户点击继续操作。"
          }
        }
      }
    },
    {
      "name": "getCurrentMeal",
      "description": "查询选定家庭当前约饭状态、本人已选菜品 ID 和点菜数量。状态0为点菜中，1为已下单；无约饭返回null。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "familyId": {
            "type": "string",
            "description": "必须来自 listMealFamilies.families[]._id，是来吃饭的家庭 ID，不能使用宠物 ID。多项时由用户选择。"
          }
        },
        "required": [
          "familyId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "familyId": {
            "type": "string"
          },
          "meal": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "integer"
                  },
                  "seq": {
                    "type": "integer"
                  },
                  "isAdmin": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "myPicks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "title": {
            "type": "string",
            "description": "页面入口的展示文字。"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "title",
            "description": "真实小程序页面入口，由用户点击继续操作。"
          }
        }
      }
    },
