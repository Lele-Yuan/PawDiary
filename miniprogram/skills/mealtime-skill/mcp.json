        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "families": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "memberCount": {
                  "type": "integer"
                },
                "cookCount": {
                  "type": "integer"
                },
                "isAdmin": {
                  "type": "boolean"
                },
                "kitchenRole": {
                  "type": "integer",
                  "description": "0为食客，1为大厨。"
                },
                "mealStatus": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "title": {
                  "type": "string",
                  "description": "页面入口的展示文字。"
                },
                "pagePath": {
                  "type": "string",
                  "format": "page-link",
                  "x-link-text-field": "title",
                  "description": "真实小程序页面入口，由用户点击继续操作。"
                }
              }
            }
          },
          "total": {
            "type": "integer"
          },
          "title": {
            "type": "string",
            "description": "页面入口的展示文字。"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "title",
            "description": "真实小程序页面入口，由用户点击继续操作。"
          }
        }
      }
