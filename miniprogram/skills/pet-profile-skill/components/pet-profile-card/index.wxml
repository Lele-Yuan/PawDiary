<view class="card" wx:if="{{data.name}}"><text>{{data.name}}</text><text>{{data.breed || data.species}}</text><text wx:if="{{data.weight !== null}}">档案体重 {{data.weight}}kg</text><text wx:else>体重未记录</text></view><view class="card" wx:elif="{{data.pets}}"><block wx:for="{{data.pets}}" wx:key="_id"><view><text>{{item.name}}</text><text>{{item.breed || item.species}}</text><text wx:if="{{item.weight !== null}}">{{item.weight}}kg</text><text wx:else>体重未记录</text></view></block></view>
