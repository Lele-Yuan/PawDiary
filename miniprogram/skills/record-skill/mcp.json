{
  "apis": [
    {
      "name": "addRecord",
      "description": "为宠物新增一条记录。当用户说\"记一下\"\"帮我记\"\"添加\"等表述并给出具体内容时调用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string", "description": "宠物名字。用户在话语中明确提到时必须填写；未提到时不要填写（缺省使用当前选中宠物）。禁止编造或猜测。" },
          "type": {
            "type": "string",
            "enum": ["weight","poop","diet","water","deworm","vaccine","checkup","illness","bath","nail","ear","paw","gland","teeth","beauty","disinfect","litter","toy","cage","abnormal","heat","trouble","stealfood"],
            "description": "记录类型。中文映射：weight=体重, poop=排便, diet=饮食, water=饮水, deworm=驱虫, vaccine=疫苗, checkup=体检, illness=生病, bath=洗澡, nail=剪指甲, ear=清耳, paw=修毛, gland=挤腺, teeth=刷牙, beauty=美容, disinfect=消毒, litter=换砂, toy=玩具, cage=清笼, abnormal=异常, heat=发情, trouble=捅娄子, stealfood=偷吃。"
          },
          "title": { "type": "string", "description": "记录标题，简短描述，例如\"体重 5.2kg\"\"驱虫拜耳\"。" },
          "date": { "type": "string", "description": "记录日期 ISO 字符串，未提日期时使用今天。" },
          "weight": { "type": "string", "description": "体重数值（type=weight 时必填）。" },
          "weightUnit": { "type": "string", "enum": ["kg","g"], "description": "体重单位，缺省 kg。" },
          "waterAmount": { "type": "string", "description": "饮水量（type=water 时填写）。" },
          "waterUnit": { "type": "string", "enum": ["ml","l"], "description": "饮水单位，缺省 ml。" },
          "foodType": { "type": "string", "description": "食物种类（type=diet 时填写）。" },
          "foodAmount": { "type": "string", "description": "食物分量。" },
          "dewormType": { "type": "string", "description": "驱虫药品名称。" },
          "vaccineType": { "type": "string", "description": "疫苗名称。" },
          "hospitalName": { "type": "string", "description": "医院名称。" },
          "cost": { "type": "number", "description": "费用，单位元。" },
          "description": { "type": "string", "description": "补充描述。" }
        },
        "required": ["type", "title"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "petName": { "type": "string" },
          "type": { "type": "string" },
          "typeName": { "type": "string" },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "weight": { "type": "string" },
          "weightUnit": { "type": "string" },
          "cost": { "type": "number" },
          "description": { "type": "string" }
        }
      },
      "_meta": { "ui": { "componentPath": "components/record-card" } }
    },
    {
      "name": "listRecords",
      "description": "查询宠物记录列表。用户问\"看看最近的xxx记录\"\"上次xxx是什么时候\"\"最近一次xxx\"等场景调用。type 不传则查全部。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string", "description": "宠物名字。规则同 addRecord。" },
          "type": {
            "type": "string",
            "description": "可选记录类型枚举（同 addRecord）。不填查询全部类型。"
          },
          "startDate": { "type": "string", "description": "起始日期 ISO 字符串。" },
          "endDate": { "type": "string", "description": "结束日期 ISO 字符串。" },
          "limit": { "type": "number", "description": "返回条数上限，默认 20。" }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "petName": { "type": "string" },
          "type": { "type": "string" },
          "typeName": { "type": "string" },
          "total": { "type": "number" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": { "type": "string" },
                "type": { "type": "string" },
                "typeName": { "type": "string" },
                "title": { "type": "string" },
                "date": { "type": "string" },
                "weight": { "type": "string" },
                "weightUnit": { "type": "string" },
                "cost": { "type": "number" }
              }
            }
          }
        }
      },
      "_meta": { "ui": { "componentPath": "components/record-list-card" } }
    },
    {
      "name": "deleteRecord",
      "description": "删除一条记录。仅当用户明确要求删除时调用。recordId 必须来自 listRecords 返回的原值，禁止编造。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "recordId": { "type": "string", "description": "要删除的记录 _id，必须来自 listRecords 接口前序返回的原始 _id。" }
        },
        "required": ["recordId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "deleted": { "type": "boolean" }
        }
      }
    }
  ],
  "components": [
    { "path": "components/record-card" },
    { "path": "components/record-list-card" }
  ]
}
